---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  pathname: string;
  keywords?: string;
}

const {
  title,
  description,
  ogImage,
  pathname,
  keywords = 'buy 480 domain, 480Local.com for sale, premium domain names, Phoenix local domain, 480 area code domain, brandable .com for sale, geo domain investment',
} = Astro.props;
const normalizedPathname = pathname.endsWith('/') ? pathname : pathname + '/';
const canonicalURL = new URL(normalizedPathname, Astro.site);
---

<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="googlebot" content="index, follow" />
<meta name="author" content="480Local.com" />
<meta name="geo.region" content="US-AZ" />
<meta name="geo.placename" content="Mesa, Chandler, Gilbert, Tempe, Scottsdale — Phoenix East Valley (480)" />
<meta name="rating" content="general" />
<meta name="revisit-after" content="7 days" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="480Local.com" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && <meta property="og:image:alt" content="480Local.com — Premium Phoenix 480 local domain for sale" />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
<meta name="twitter:image:alt" content="480Local.com — Premium Phoenix 480 local domain for sale" />
