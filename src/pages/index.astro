---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';

const title = '480Local.com | Premium Domain for Sale | 480Local';
const description =
  '480Local.com for sale — premium 480 area-code .com for Phoenix East Valley. One-of-one asset. All serious offers considered. Secure Escrow.com transfer. Inquire now — response within 24 hours.';
const ogImage = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/9359f4df-e8a3-4e6a-8505-1ed0fb40f700/public';
const heroImage = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/c1446cef-bfec-419d-afa1-dd4320641200/public';
const offerMailto =
  'mailto:sales@desertrich.com?subject=Offer%20for%20480Local.com%20%E2%80%94%20%5BYour%20Offer%5D&body=Hi%2C%0A%0AI%27d%20like%20to%20make%20an%20offer%20for%20480Local.com.%0A%0AOffer%20amount%20(USD)%3A%20%0AIntended%20use%3A%20%0AName%3A%20%0A%0AThank%20you!';
const buyNowMailto =
  'mailto:sales@desertrich.com?subject=Buy%20Now%20%E2%80%94%20480Local.com%20via%20Escrow&body=Hi%2C%0A%0AI%27d%20like%20to%20proceed%20with%20a%20secure%20Escrow.com%20transaction%20for%20480Local.com.%20Please%20send%20next%20steps.%0A%0AName%3A%20%0A';
const agentMailto =
  'mailto:sales@desertrich.com?subject=Questions%20about%20480Local.com&body=Hi%2C%0A%0AI%20have%20a%20question%20about%20480Local.com%3A%20%0A%0AName%3A%20%0A';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://480local.com/#website',
      name: '480Local.com',
      url: 'https://480local.com/',
      description: description,
      inLanguage: 'en-US',
    },
    {
      '@type': 'Organization',
      '@id': 'https://480local.com/#org',
      name: '480Local',
      url: 'https://480local.com/',
      logo: 'https://480local.com/favicon.svg',
      email: 'sales@desertrich.com',
      areaServed: 'Phoenix East Valley — Mesa, Chandler, Gilbert, Tempe, Scottsdale (480)',
    },
    {
      '@type': 'Product',
      '@id': 'https://480local.com/#product',
      name: '480Local.com',
      description:
        'Premium 9-character .com combining the iconic Phoenix 480 area code with the high-intent keyword "local". Ideal for hyperlocal platforms, directories, or East Valley brand authority.',
      brand: { '@type': 'Brand', name: '480Local' },
      category: 'Premium domain name',
      url: 'https://480local.com/',
      image: ogImage,
      offers: {
        '@type': 'Offer',
        url: 'https://480local.com/#offer',
        availability: 'https://schema.org/InStock',
        priceCurrency: 'USD',
        price: '50000',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          minPrice: '50000',
          maxPrice: '99999',
          priceCurrency: 'USD',
        },
        businessFunction: 'https://purl.org/goodrelations/v1#Sell',
        seller: { '@id': 'https://480local.com/#org' },
        description: 'All serious offers considered. Secure transfer via Escrow.com or equivalent.',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '480Local.com', item: 'https://480local.com/' },
        { '@type': 'ListItem', position: 2, name: 'Why This Domain', item: 'https://480local.com/#why' },
        { '@type': 'ListItem', position: 3, name: 'How to Acquire', item: 'https://480local.com/#acquire' },
        { '@type': 'ListItem', position: 4, name: 'Make an Offer', item: 'https://480local.com/#offer' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How much does 480Local.com cost?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'All serious offers are considered — there is no fixed list price. Comparable geo + keyword premium .com domains in growing markets routinely transact in the mid-to-high five figures. Submit your best offer and receive a personal response within 24 hours.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does the secure transfer work?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'We recommend Escrow.com, Dan.com, or your attorney/escrow service. Funds are held securely, then the domain is pushed or transferred by auth code (registered at Cloudflare) within 1–3 business days after funds clear.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why is a 480 geo domain valuable?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: '480 is the iconic Phoenix East Valley area code covering Mesa, Chandler, Gilbert, Tempe and Scottsdale. Paired with "local" — one of the highest commercial-intent keywords — it gives instant recognition, type-in traffic, and SEO headroom for any local platform or business.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I buy now instead of making an offer?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Use the Buy Now option to start a secure Escrow.com transaction immediately, or Contact Agent with questions. Make Offer is best if you want to propose terms.',
          },
        },
        {
          '@type': 'Question',
          name: 'What can I build on 480Local.com?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Two proven paths: (1) the definitive 480 hyperlocal platform — news, events, directory, deals; or (2) instant local authority for real estate, home services, healthcare, hospitality, professional services, retail, or trades.',
          },
        },
      ],
    },
  ],
};

const faqs = [
  {
    q: 'How much does 480Local.com cost?',
    a: 'All serious offers are considered — there is no fixed list price. Comparable geo + keyword premium .com domains in growing markets routinely transact in the mid-to-high five figures. Submit your best offer; every serious inquiry gets a personal response within 24 hours.',
  },
  {
    q: 'How does the secure transfer work?',
    a: 'We recommend Escrow.com, Dan.com, or your attorney/escrow service. Funds are held securely, then the domain is pushed or transferred by auth code (registered at Cloudflare) within 1–3 business days after funds clear.',
  },
  {
    q: 'Why is a 480 geo domain valuable?',
    a: '480 is the iconic Phoenix East Valley area code — Mesa, Chandler, Gilbert, Tempe, Scottsdale. Paired with “local”, one of the highest commercial-intent keywords in search, it delivers instant recognition, type-in traffic, and long-term brand equity.',
  },
  {
    q: 'Can I buy now instead of making an offer?',
    a: 'Yes. Choose Buy Now to start a secure Escrow.com transaction immediately, Contact Agent for questions, or Make Offer to propose your terms. All three take under a minute.',
  },
  {
    q: 'What can I build on 480Local.com?',
    a: 'Two proven paths: (1) the definitive 480 hyperlocal platform — news, events, business directory, deals and community; or (2) instant local authority for real estate, home services, healthcare, hospitality, professional services, retail, or trades.',
  },
];

const useCases = [
  { label: 'All', filter: 'all' },
  { label: 'Media & Directory', filter: 'platform' },
  { label: 'Real Estate', filter: 'services' },
  { label: 'Home Services', filter: 'services' },
  { label: 'Healthcare', filter: 'services' },
  { label: 'Hospitality', filter: 'services' },
];
---

<Layout title={title} description={description} ogImage={ogImage}>
  <SEO slot="head" title={title} description={description} ogImage={ogImage} pathname="/" />
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero Section -->
  <header id="top" class="relative overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 lg:hidden" aria-hidden="true">
      <img
        src={heroImage}
        alt=""
        width="1600"
        height="900"
        class="h-full w-full object-cover opacity-35"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/95 via-slate-950/80 to-slate-950"></div>
    </div>

    <div class="relative max-w-screen-2xl mx-auto">
      <div class="grid lg:grid-cols-[1fr_minmax(0,44%)] xl:grid-cols-[1fr_minmax(0,48%)] lg:min-h-[34rem]">
        <div class="px-4 sm:px-8 pt-12 pb-16 sm:pt-16 sm:pb-20 md:pt-20 md:pb-24 lg:flex lg:flex-col lg:justify-center">
          <div class="max-w-4xl">
            <!-- Trust Badge + urgency -->
            <div class="flex flex-wrap items-center gap-2 mb-6 sm:mb-8">
              <span class="inline-flex items-center gap-x-2 px-3 sm:px-4 py-1.5 min-h-[32px] rounded-3xl bg-white/10 backdrop-blur-md border border-white/20 max-w-full">
                <span class="w-2 h-2 shrink-0 bg-emerald-400 rounded-full animate-pulse" aria-hidden="true"></span>
                <span class="text-[10px] sm:text-xs font-semibold tracking-widest uppercase">Premium Domain &bull; Available Now</span>
              </span>
              <span class="inline-flex items-center px-3 py-1.5 min-h-[32px] rounded-3xl bg-amber-400/15 border border-amber-300/30 text-amber-200 text-[10px] sm:text-xs font-semibold tracking-widest uppercase">
                1 of 1 &bull; When it&rsquo;s gone, it&rsquo;s gone
              </span>
            </div>

            <h1 class="text-[2.75rem] leading-none sm:text-6xl md:text-7xl font-semibold tracking-tighter mb-5 sm:mb-6 break-words" style="font-family: 'Space Grotesk', sans-serif;">
              480Local<span class="text-amber-400">.</span>com
            </h1>

            <p class="max-w-2xl text-xl sm:text-2xl md:text-3xl font-light text-white/90 tracking-tight mb-4 leading-snug sm:leading-tight">
              The most powerful, memorable domain for everything <span class="font-medium text-white">local in the 480</span>.
            </p>
            <p class="max-w-2xl text-base sm:text-lg text-white/70 mb-8 sm:mb-10">
              One-of-one .com &bull; All serious offers considered &bull; Secure Escrow.com transfer
            </p>

            <!-- Tiered CTAs: Make Offer / Buy Now / Contact Agent -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 w-full sm:w-auto" role="group" aria-label="Purchase options">
              <a
                href={offerMailto}
                data-track="hero-make-offer"
                class="group inline-flex items-center justify-center gap-x-3 px-6 sm:px-9 py-3.5 sm:py-4 min-h-[48px] text-base sm:text-lg font-semibold bg-amber-400 hover:bg-amber-300 active:bg-amber-500 text-slate-950 rounded-3xl transition-all active:scale-[0.985] shadow-xl shadow-amber-900/30"
              >
                <span>Make an Offer</span>
                <svg class="w-5 h-5 group-active:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href={buyNowMailto}
                data-track="hero-buy-now"
                class="inline-flex items-center justify-center gap-x-2 px-6 sm:px-7 py-3.5 sm:py-4 min-h-[48px] text-base font-semibold bg-white text-slate-950 hover:bg-amber-100 rounded-3xl transition-all active:scale-[0.985]"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span>Buy Now via Escrow</span>
              </a>

              <a
                href={agentMailto}
                data-track="hero-contact-agent"
                class="inline-flex items-center justify-center gap-x-2 px-6 sm:px-7 py-3.5 sm:py-4 min-h-[48px] text-base font-medium border border-white/30 hover:bg-white/10 text-white rounded-3xl transition-all"
              >
                <span>Contact Agent</span>
              </a>
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs sm:text-sm text-white/70">
              <span class="inline-flex items-center gap-x-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                Escrow.com &amp; Dan.com supported
              </span>
              <span class="inline-flex items-center gap-x-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Response within 24 hours
              </span>
              <span class="inline-flex items-center gap-x-2" aria-live="polite">
                <span class="w-2 h-2 bg-amber-400 rounded-full animate-pulse" aria-hidden="true"></span>
                <span id="viewer-count">Serious inquiries from local brands &amp; investors this month</span>
              </span>
            </div>
          </div>
        </div>

        <div class="relative hidden lg:block min-h-full" aria-hidden="true">
          <img
            src={heroImage}
            alt="Phoenix East Valley skyline representing the 480 local area"
            width="1600"
            height="900"
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            sizes="(min-width: 1024px) 44vw, 100vw"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/50 to-transparent"></div>
          <!-- Domain visualization mockup -->
          <div class="absolute bottom-8 right-8 left-8 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20 p-5">
            <div class="flex items-center gap-x-2 mb-3">
              <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-400/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-400/80"></span>
              <span class="ml-2 text-xs font-mono text-white/70 bg-black/30 rounded-lg px-3 py-1">480local.com</span>
            </div>
            <div class="text-2xl font-semibold tracking-tight" style="font-family: 'Space Grotesk', sans-serif;">480Local.com</div>
            <div class="text-sm text-white/70">Mesa &bull; Chandler &bull; Gilbert &bull; Tempe &bull; Scottsdale</div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Trust Bar -->
  <div class="border-b border-slate-200 bg-white">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-8 py-5">
      <div class="flex flex-wrap justify-center md:justify-between items-center gap-x-6 sm:gap-x-8 gap-y-3 sm:gap-y-4 text-xs md:text-sm text-slate-500 font-medium text-center md:text-left">
        <div class="flex items-center gap-x-2 max-w-full">
          <svg class="w-4 h-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Secure escrow transactions &mdash; Escrow.com / Dan.com / attorney</span>
        </div>
        <div class="flex items-center gap-x-2 max-w-full">
          <svg class="w-4 h-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Instant brand recognition across Mesa &bull; Chandler &bull; Gilbert &bull; Tempe &bull; Scottsdale</span>
        </div>
        <div class="flex items-center gap-x-2 max-w-full">
          <svg class="w-4 h-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          <span>SSL secured &bull; Cloudflare registrar transfer in 1&ndash;3 days</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Why This Domain Section -->
  <section id="why" class="max-w-screen-2xl mx-auto px-4 sm:px-8 pt-12 sm:pt-16 pb-12 scroll-mt-20">
    <div class="max-w-3xl mx-auto text-center mb-10 sm:mb-12 reveal">
      <div class="modern-pill mb-4">WHY BUYERS CHOOSE 480LOCAL.COM</div>
      <h2 class="section-title text-[1.75rem] sm:text-4xl md:text-[2.75rem]">Built for local dominance.<br />Designed for brand power.</h2>
      <p class="mt-4 text-lg sm:text-xl text-slate-600">
        A rare combination of geographic precision, keyword strength, and memorability that very few domains can match.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5 max-w-7xl mx-auto">
      <div class="modern-card reveal">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl tracking-tight mb-3">Instant Local Authority</h3>
        <p class="text-slate-600 leading-relaxed text-base">
          480 is the iconic area code for Phoenix's East Valley. Instantly signals "we're local" to every resident and business in the region.
        </p>
      </div>

      <div class="modern-card reveal" style="--reveal-delay: 80ms">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl tracking-tight mb-3">High-Intent Keywords</h3>
        <p class="text-slate-600 leading-relaxed text-base">
          "Local" is one of the highest commercial intent keywords in local search. Combined with 480, you own the exact phrase people use when looking for trusted local options.
        </p>
      </div>

      <div class="modern-card reveal" style="--reveal-delay: 160ms">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-slate-700 to-slate-900 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl tracking-tight mb-3">Short &amp; Brandable</h3>
        <p class="text-slate-600 leading-relaxed text-base">
          Only 9 characters. Easy to say, spell, type, and remember. Perfect for logos, apps, voice search, signage, and word-of-mouth.
        </p>
      </div>

      <div class="modern-card reveal" style="--reveal-delay: 240ms">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl tracking-tight mb-3">Future-Proof Asset</h3>
        <p class="text-slate-600 leading-relaxed text-base">
          Phoenix metro continues explosive growth. Owning the best local domain in the 480 footprint is a long-term strategic advantage that only appreciates.
        </p>
      </div>
    </div>
  </section>

  <!-- The Cohesive Opportunity + category filter -->
  <section id="opportunity" class="bg-white border-y border-slate-200 py-12 sm:py-16 scroll-mt-20">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-8">
      <div class="max-w-3xl mx-auto text-center mb-10 sm:mb-12 reveal">
        <div class="inline-block px-4 py-1 rounded-2xl bg-emerald-100 text-emerald-700 text-xs font-bold tracking-[1.5px] mb-4">A COHESIVE VISION</div>
        <h2 class="section-title text-[1.75rem] sm:text-4xl md:text-[2.75rem]">One domain.<br />Two powerful paths.</h2>
        <p class="mt-4 text-lg sm:text-xl text-slate-600 max-w-md mx-auto">
          Whether you want to <span class="font-semibold text-slate-900">build the local platform</span> or <span class="font-semibold text-slate-900">become the local authority</span> in your niche — 480Local.com is engineered for both.
        </p>
      </div>

      <!-- Portfolio-style filter (no backend, instant) -->
      <div class="flex flex-wrap justify-center gap-2 mb-8 reveal" role="group" aria-label="Filter use cases">
        {useCases.map((u, i) => (
          <button
            type="button"
            data-filter={u.filter}
            class={`usecase-filter px-4 py-2 min-h-[44px] text-sm font-medium rounded-2xl border transition-all ${i === 0 ? 'bg-slate-900 text-white border-slate-900' : 'bg-white border-slate-200 hover:bg-slate-50'}`}
          >
            {u.label}
          </button>
        ))}
      </div>

      <div class="grid lg:grid-cols-2 gap-6 max-w-6xl mx-auto">
        <div class="usecase-card group border border-slate-200 rounded-3xl p-6 sm:p-9 bg-slate-50 hover:border-amber-200 transition-colors flex flex-col reveal" data-tags="platform">
          <div class="flex items-center gap-x-4 mb-6">
            <div class="w-[52px] h-[52px] flex items-center justify-center rounded-full bg-gradient-to-br from-amber-400 to-orange-500 text-slate-900">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
