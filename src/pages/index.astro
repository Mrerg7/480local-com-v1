---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';

const title = '480Local.com | Premium Domain for Sale • Phoenix 480 Local Authority';
const description =
  '480Local.com — The premium, brandable .com domain for hyperlocal Phoenix and the 480 area code. Perfect for local platforms, directories, events, or instantly elevating any East Valley business. Now available.';
const ogImage = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/9359f4df-e8a3-4e6a-8505-1ed0fb40f700/public';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '480Local.com',
  url: 'https://480local.com/',
  description: description,
};
---

<Layout title={title} description={description} ogImage={ogImage}>
  <SEO slot="head" title={title} description={description} ogImage={ogImage} pathname="/" />
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero Section -->
  <header class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-950 text-white">
    <div class="max-w-screen-2xl mx-auto px-8 pt-16 pb-20 md:pt-20 md:pb-24">
      <div class="max-w-4xl">
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20 mb-8">
          <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
          <span class="text-xs font-semibold tracking-widest uppercase">Premium Domain &bull; Available Now</span>
        </div>

        <h1 class="text-6xl md:text-7xl font-semibold tracking-tighter leading-none mb-6" style="font-family: 'Space Grotesk', sans-serif;">
          480Local<span class="text-amber-400">.</span>com
        </h1>

        <p class="max-w-2xl text-2xl md:text-3xl font-light text-white/90 tracking-tight mb-10 leading-tight">
          The most powerful, memorable domain for everything <span class="font-medium text-white">local in the 480</span>.
        </p>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <a
            href="mailto:sales@desertrich.com?subject=Acquisition%20Inquiry%20-%20480local.com"
            class="group inline-flex items-center justify-center gap-x-3 px-9 py-4 text-lg font-semibold bg-amber-400 hover:bg-amber-300 active:bg-amber-500 text-slate-950 rounded-3xl transition-all active:scale-[0.985] shadow-xl shadow-amber-900/30"
          >
            <span>Secure This Domain</span>
            <svg class="w-5 h-5 group-active:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="#why"
            class="inline-flex items-center justify-center gap-x-2 px-7 py-4 text-base font-medium border border-white/30 hover:bg-white/10 text-white rounded-3xl transition-all"
          >
            <span>Why it wins</span>
          </a>
        </div>

        <div class="mt-10 flex items-center gap-x-8 text-sm">
          <div class="flex -space-x-2">
            <div class="w-7 h-7 bg-white/90 rounded-full ring-2 ring-slate-900"></div>
            <div class="w-7 h-7 bg-white/80 rounded-full ring-2 ring-slate-900"></div>
            <div class="w-7 h-7 bg-white/70 rounded-full ring-2 ring-slate-900"></div>
          </div>
          <div class="text-white/70 text-xs font-medium tracking-wider">
            SERIOUS INQUIRIES FROM LOCAL BRANDS &amp; INVESTORS THIS MONTH
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Trust Bar -->
  <div class="border-b border-slate-200 bg-white">
    <div class="max-w-screen-2xl mx-auto px-8 py-5">
      <div class="flex flex-wrap justify-center md:justify-between items-center gap-x-8 gap-y-4 text-xs md:text-sm text-slate-500 font-medium">
        <div class="flex items-center gap-x-2">
          <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Secure escrow transactions recommended</span>
        </div>
        <div class="flex items-center gap-x-2">
          <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Instant brand recognition across Mesa &bull; Chandler &bull; Gilbert &bull; Tempe &bull; Scottsdale</span>
        </div>
        <div class="flex items-center gap-x-2">
          <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          <span>High local search intent + commercial value</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Why This Domain Section -->
  <section id="why" class="max-w-screen-2xl mx-auto px-8 pt-16 pb-12">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <div class="modern-pill mb-4">WHY BUYERS CHOOSE 480LOCAL.COM</div>
      <h2 class="section-title">Built for local dominance.<br />Designed for brand power.</h2>
      <p class="mt-4 text-xl text-slate-600">
        A rare combination of geographic precision, keyword strength, and memorability that very few domains can match.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5 max-w-7xl mx-auto">
      <!-- Card 1 -->
      <div class="modern-card">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl tracking-tight mb-3">Instant Local Authority</h3>
        <p class="text-slate-600 leading-relaxed">
          480 is the iconic area code for Phoenix's East Valley. Instantly signals "we're local" to every resident and business in the region.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="modern-card">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl tracking-tight mb-3">High-Intent Keywords</h3>
        <p class="text-slate-600 leading-relaxed">
          "Local" is one of the highest commercial intent keywords in local search. Combined with 480, you own the exact phrase people use when looking for trusted local options.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="modern-card">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-slate-700 to-slate-900 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl tracking-tight mb-3">Short &amp; Brandable</h3>
        <p class="text-slate-600 leading-relaxed">
          Only 9 characters. Easy to say, spell, type, and remember. Perfect for logos, apps, voice search, signage, and word-of-mouth.
        </p>
      </div>

      <!-- Card 4 -->
      <div class="modern-card">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl tracking-tight mb-3">Future-Proof Asset</h3>
        <p class="text-slate-600 leading-relaxed">
          Phoenix metro continues explosive growth. Owning the best local domain in the 480 footprint is a long-term strategic advantage that only appreciates.
        </p>
      </div>
    </div>
  </section>

  <!-- The Cohesive Opportunity -->
  <section id="opportunity" class="bg-white border-y border-slate-200 py-16">
    <div class="max-w-screen-2xl mx-auto px-8">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <div class="inline-block px-4 py-1 rounded-2xl bg-emerald-100 text-emerald-700 text-xs font-bold tracking-[1.5px] mb-4">A COHESIVE VISION</div>
        <h2 class="section-title">One domain.<br />Two powerful paths.</h2>
        <p class="mt-4 text-xl text-slate-600 max-w-md mx-auto">
          Whether you want to <span class="font-semibold text-slate-900">build the local platform</span> or <span class="font-semibold text-slate-900">become the local authority</span> in your niche — 480Local.com is engineered for both.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 max-w-6xl mx-auto">
        <!-- Path 1 -->
        <div class="group border border-slate-200 rounded-3xl p-9 bg-slate-50 hover:border-amber-200 transition-colors flex flex-col">
          <div class="flex items-center gap-x-4 mb-6">
            <div class="w-[52px] h-[52px] flex items-center justify-center rounded-full bg-gradient-to-br from-amber-400 to-orange-500 text-slate-900">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <span class="px-3 py-1 text-xs font-bold tracking-widest bg-white border border-slate-200 rounded-2xl">PATH 1</span>
            </div>
          </div>

          <h3 class="text-3xl font-semibold tracking-tighter mb-4" style="font-family: 'Space Grotesk', sans-serif;">
            Build the Definitive 480 Local Platform
          </h3>

          <p class="text-slate-600 mb-8 leading-relaxed">
            Launch the trusted hub for everything happening in the 480. A hyperlocal destination combining news, events, business directory, deals, and community connection.
          </p>

          <div class="mt-auto">
            <div class="text-xs font-bold tracking-widest text-slate-500 mb-3">IDEAL FOR</div>
            <div class="flex flex-wrap gap-2">
              <span class="px-4 py-1.5 text-xs font-medium bg-white border border-slate-200 rounded-2xl">Hyperlocal News &amp; Media</span>
              <span class="px-4 py-1.5 text-xs font-medium bg-white border border-slate-200 rounded-2xl">Community Directory</span>
              <span class="px-4 py-1.5 text-xs font-medium bg-white border border-slate-200 rounded-2xl">Events &amp; Experiences</span>
              <span class="px-4 py-1.5 text-xs font-medium bg-white border border-slate-200 rounded-2xl">Local Deals &amp; Marketplace</span>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-200 text-sm">
              <div class="flex items-center gap-x-2 text-emerald-600 font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Own the exact-match brand for "480 local" searches</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Path 2 -->
        <div class="group border border-slate-200 rounded-3xl p-9 bg-white hover:border-amber-200 transition-colors flex flex-col">
          <div class="flex items-center gap-x-4 mb-6">
            <div class="w-[52px] h-[52px] flex items-center justify-center rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 text-white">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div>
              <span class="px-3 py-1 text-xs font-bold tracking-widest bg-white border border-slate-200 rounded-2xl">PATH 2</span>
            </div>
          </div>

          <h3 class="text-3xl font-semibold tracking-tighter mb-4" style="font-family: 'Space Grotesk', sans-serif;">
            Instant Local Credibility for Your Business
          </h3>

          <p class="text-slate-600 mb-8 leading-relaxed">
            Rebrand or launch your local service, practice, or store with a name that instantly communicates trust, proximity, and expertise to every customer in the 480.
          </p>

          <div class="mt-auto">
            <div class="text-xs font-bold tracking-widest text-slate-500 mb-3">PERFECT FOR</div>
            <div class="grid grid-cols-2 gap-2 text-sm">
              <div class="flex items-center gap-x-2 text-slate-700">
                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Real Estate &amp; Home Services</span>
              </div>
              <div class="flex items-center gap-x-2 text-slate-700">
                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Healthcare &amp; Wellness</span>
              </div>
              <div class="flex items-center gap-x-2 text-slate-700">
                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Restaurants &amp; Hospitality</span>
              </div>
              <div class="flex items-center gap-x-2 text-slate-700">
                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Professional Services</span>
              </div>
              <div class="flex items-center gap-x-2 text-slate-700">
                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Local Retail &amp; E-commerce</span>
              </div>
              <div class="flex items-center gap-x-2 text-slate-700">
                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Contractors &amp; Trades</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Market Context -->
  <section class="max-w-screen-2xl mx-auto px-8 py-16">
    <div class="max-w-5xl mx-auto">
      <div class="grid md:grid-cols-12 gap-x-12 items-center">
        <div class="md:col-span-5">
          <div class="md:sticky md:top-24">
            <div class="text-xs font-bold tracking-[2px] text-amber-600 mb-3">THE PHOENIX 480 ADVANTAGE</div>
            <h2 class="section-title leading-none">One of the fastest-growing major metros in America.</h2>
            <p class="mt-6 text-lg text-slate-600">
              The 480 footprint (Mesa, Chandler, Gilbert, Tempe and surrounding communities) continues to attract residents, businesses, and investment at an extraordinary pace.
            </p>

            <div class="mt-8 flex items-center gap-x-3 text-sm">
              <div class="px-4 py-2 bg-white border border-slate-200 rounded-2xl text-center">
                <div class="font-mono text-2xl font-semibold text-slate-900">5M+</div>
                <div class="text-xs text-slate-500 tracking-wider">Metro Population</div>
              </div>
              <div class="px-4 py-2 bg-white border border-slate-200 rounded-2xl text-center">
                <div class="font-mono text-2xl font-semibold text-slate-900">Top 5</div>
                <div class="text-xs text-slate-500 tracking-wider">Fastest Growing Large U.S. Metro</div>
              </div>
            </div>
          </div>
        </div>

        <div class="md:col-span-7 mt-10 md:mt-0">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-slate-50 border border-slate-200 rounded-3xl p-6">
              <div class="text-emerald-600 text-xs font-bold tracking-widest">POPULATION GROWTH</div>
              <div class="mt-3 text-4xl font-semibold tracking-tighter">+15.8%</div>
              <div class="text-sm text-slate-600 mt-1">Since 2020 — among the highest of any major metro</div>
            </div>
            <div class="bg-slate-50 border border-slate-200 rounded-3xl p-6">
              <div class="text-emerald-600 text-xs font-bold tracking-widest">BUSINESS &amp; JOBS</div>
              <div class="mt-3 text-4xl font-semibold tracking-tighter">Strong</div>
              <div class="text-sm text-slate-600 mt-1">Tech, healthcare, finance, advanced manufacturing &amp; construction boom</div>
            </div>
            <div class="bg-slate-50 border border-slate-200 rounded-3xl p-6">
              <div class="text-emerald-600 text-xs font-bold tracking-widest">IN-MIGRATION</div>
              <div class="mt-3 text-4xl font-semibold tracking-tighter">Record</div>
              <div class="text-sm text-slate-600 mt-1">Thousands of new households annually seeking the Arizona lifestyle</div>
            </div>
          </div>

          <div class="mt-6 text-xs text-slate-500 px-1">
            Source: U.S. Census Bureau, Bureau of Labor Statistics, and local economic development reports. Phoenix metro remains one of the top relocation destinations in the United States.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Domain Value Section -->
  <section id="value" class="bg-slate-900 text-white py-16">
    <div class="max-w-screen-2xl mx-auto px-8">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <div class="text-amber-400 text-xs font-bold tracking-[2.5px]">PREMIUM ASSET CHARACTERISTICS</div>
        <h2 class="section-title mt-3 text-white">Why this domain holds exceptional value</h2>
      </div>

      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6">
        <div class="bg-white/5 border border-white/10 rounded-3xl p-8">
          <div class="font-mono text-5xl font-semibold tracking-tighter text-white mb-1">9</div>
          <div class="text-lg font-medium">Characters</div>
          <div class="mt-4 text-sm text-white/70">Extremely short and brandable. Ideal length for logos, apps, and verbal sharing.</div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-3xl p-8">
          <div class="font-mono text-5xl font-semibold tracking-tighter text-white mb-1">.COM</div>
          <div class="text-lg font-medium">The Gold Standard</div>
          <div class="mt-4 text-sm text-white/70">Maximum trust, type-in traffic, and resale liquidity. The only TLD most consumers instinctively trust.</div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-3xl p-8">
          <div class="font-mono text-5xl font-semibold tracking-tighter text-white mb-1">480</div>
          <div class="text-lg font-medium">Exact Local Match</div>
          <div class="mt-4 text-sm text-white/70">The area code locals instantly recognize and trust. Pairs perfectly with high-intent commercial keyword "local".</div>
        </div>
      </div>

      <div class="max-w-4xl mx-auto mt-12 text-center">
        <p class="text-white/70 text-sm max-w-md mx-auto">
          Comparable geo + keyword and premium short .com domains in growing markets routinely transact in the mid-to-high five figures when they offer clear commercial utility and brand strength.
        </p>

        <div class="mt-8 inline-flex items-center gap-x-2 text-xs px-5 py-3 bg-white/5 border border-white/10 rounded-3xl">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="font-medium">All serious offers considered. Escrow.com or equivalent recommended for secure transfer.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- How to Acquire -->
  <section id="acquire" class="max-w-screen-2xl mx-auto px-8 py-20">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <div class="inline px-4 py-1 text-xs font-bold tracking-widest bg-slate-100 text-slate-600 rounded-2xl">SIMPLE &amp; SECURE</div>
