          </a>
        </div>
        <p class="text-xs text-slate-500 text-center pt-1">Confidential &bull; No obligation &bull; Escrow.com recommended &bull; Response within 24 hours</p>
      </form>
    </div>
  </section>

  <!-- Final CTA -->
  <div class="bg-gradient-to-br from-slate-900 via-slate-950 to-black py-12 sm:py-16 text-white">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-8 text-center">
      <div class="max-w-lg mx-auto reveal">
        <h2 class="text-3xl sm:text-5xl font-semibold tracking-tighter leading-tight" style="font-family: 'Space Grotesk', sans-serif;">
          Ready to own the local internet in the 480?
        </h2>
        <p class="mt-4 text-white/70 text-base">This is a rare opportunity to acquire a truly strategic local asset before someone else does.</p>

        <div class="mt-8 sm:mt-9 flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href={offerMailto}
            data-track="final-make-offer"
            class="inline-flex items-center justify-center gap-x-3 px-6 sm:px-10 py-[15px] sm:py-[17px] min-h-[48px] text-base sm:text-lg font-semibold bg-amber-400 hover:bg-amber-300 text-slate-950 rounded-3xl shadow-2xl transition-all w-full sm:w-auto"
          >
            <span>Submit Your Offer Now</span>
          </a>
          <a
            href={buyNowMailto}
            data-track="final-buy-now"
            class="inline-flex items-center justify-center gap-x-2 px-6 sm:px-8 py-[15px] sm:py-[17px] min-h-[48px] text-base font-semibold bg-white text-slate-950 hover:bg-amber-100 rounded-3xl transition-all w-full sm:w-auto"
          >
            <span>Buy Now</span>
          </a>
        </div>

        <div class="mt-5 text-xs text-white/50">Confidential &bull; No obligation &bull; Response within 24 hours &bull; Secure escrow only</div>
      </div>
    </div>
  </div>

  <!-- Exit-intent capture (free: no backend, mailto + 14-day local snooze) -->
  <div id="exit-intent" class="hidden fixed inset-0 z-[120] items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="exit-title">
    <div id="exit-backdrop" class="absolute inset-0 bg-black/60"></div>
    <div class="relative bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl">
      <button id="exit-close" type="button" aria-label="Close offer" class="absolute top-3 right-3 w-12 h-12 inline-flex items-center justify-center text-2xl text-slate-400 hover:text-slate-700 rounded-2xl">&times;</button>
      <div class="text-xs font-bold tracking-widest text-amber-600 mb-2">BEFORE YOU GO</div>
      <h2 id="exit-title" class="text-2xl font-bold tracking-tight">Get first refusal on 480Local.com</h2>
      <p class="mt-2 text-slate-600 text-base">One-of-one asset. Leave your email and we&rsquo;ll notify you before accepting any other offer — plus share comparable sales data.</p>
      <form id="exit-form" class="mt-5 flex flex-col gap-3">
        <label for="exit-email" class="sr-only">Email address</label>
        <input id="exit-email" type="email" required autocomplete="email" placeholder="you@company.com" class="w-full min-h-[48px] px-4 py-3 rounded-2xl border border-slate-300 text-base" />
        <button type="submit" data-track="exit-submit" class="w-full min-h-[48px] px-6 py-3 bg-slate-900 hover:bg-black text-white font-semibold rounded-2xl transition-all">Notify Me First</button>
      </form>
      <button id="exit-dismiss" type="button" class="mt-3 w-full min-h-[44px] text-sm text-slate-500 hover:text-slate-700">No thanks, I&rsquo;ll risk missing it</button>
    </div>
  </div>

  <script is:inline>
    // Viewing counter (social proof, no backend: deterministic base + session bump)
    (() => {
      const el = document.getElementById('viewer-count');
      if (!el) return;
      const base = 140 + (new Date().getDate() % 25);
      let bump = 0;
      try {
        bump = Number(sessionStorage.getItem('480local-views') || 0) + 1;
        sessionStorage.setItem('480local-views', String(bump));
      } catch (e) { bump = 1; }
      el.textContent = `${base + bump} investors viewed this domain this week`;
    })();

    // Use-case filter chips (instant, no backend)
    (() => {
      const btns = Array.from(document.querySelectorAll('.usecase-filter'));
      const cards = Array.from(document.querySelectorAll('.usecase-card'));
      if (!btns.length || !cards.length) return;
      const active = 'bg-slate-900 text-white border-slate-900';
      const idle = 'bg-white border-slate-200 hover:bg-slate-50';
      btns.forEach((b) => {
        b.addEventListener('click', () => {
          btns.forEach((x) => {
            x.className = x.className.replace(active, '').trim();
            if (!x.className.includes('bg-white')) x.className += ' ' + idle;
          });
          b.className = b.className.replace(idle, '').trim() + ' ' + active;
          const f = b.getAttribute('data-filter');
          cards.forEach((c) => {
            const tags = (c.getAttribute('data-tags') || '').split(' ');
            const show = f === 'all' || tags.includes(f || '');
            c.style.display = show ? '' : 'none';
          });
        });
      });
    })();

    // Offer form -> prefilled secure email (nothing stored server-side = free plan)
    (() => {
      const form = document.getElementById('offer-form');
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('f-name').value.trim();
        const email = document.getElementById('f-email').value.trim();
        const amount = document.getElementById('f-amount').value.trim();
        const use = document.getElementById('f-use').value;
        const msg = document.getElementById('f-msg').value.trim();
        const err = document.getElementById('form-error');
        const ok = name.length > 1 && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email);
        if (!ok) {
          err?.classList.remove('hidden');
          (!name ? document.getElementById('f-name') : document.getElementById('f-email'))?.focus();
          return;
        }
        err?.classList.add('hidden');
        const body = `Hi,%0A%0AI'd like to make an offer for 480Local.com.%0A%0AOffer amount (USD): ${encodeURIComponent(amount || '—')}%0AIntended use: ${encodeURIComponent(use)}%0AName: ${encodeURIComponent(name)}%0AEmail: ${encodeURIComponent(email)}%0A${msg ? 'Message: ' + encodeURIComponent(msg) + '%0A' : ''}%0AThank you!`;
        window.location.href = `mailto:sales@desertrich.com?subject=${encodeURIComponent('Offer for 480Local.com — ' + (amount ? '$' + amount : name))}&body=${body}`;
      });
    })();

    // Exit-intent (engagement-gated: genuine leave signals only, 14-day snooze).
    // Triggers: desktop mouseleave-top after 20s dwell, OR 60%+ scroll depth
    // after 30s dwell. No timed auto-popup. Suppressed when the offer form is
    // on screen, after any offer/buy CTA click, or after form submission.
    (() => {
      const box = document.getElementById('exit-intent');
      if (!box) return;
      const KEY = '480local-exit-v1';
      const DONE = '480local-converted';
      const SNOOZE_MS = 14 * 24 * 60 * 60 * 1000;
      const t0 = Date.now();
      const dwell = () => Date.now() - t0;
      let shown = false;

      const suppressed = () => {
        if (shown) return true;
        try {
          if (localStorage.getItem(DONE) === '1') return true;
          const last = Number(localStorage.getItem(KEY) || 0);
          if (last && Date.now() - last < SNOOZE_MS) return true;
        } catch (e) {}
        return false;
      };
      const offerVisible = () => {
        const offer = document.getElementById('offer');
        if (!offer) return false;
        const r = offer.getBoundingClientRect();
        return r.top < window.innerHeight && r.bottom > 0;
      };
      const open = () => {
        if (suppressed() || document.hidden || offerVisible()) return;
        shown = true;
        try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {}
        box.classList.remove('hidden');
        box.classList.add('flex');
        document.getElementById('exit-email')?.focus();
      };
      const close = () => {
        box.classList.add('hidden');
        box.classList.remove('flex');
      };
      const markConverted = () => {
        try { localStorage.setItem(DONE, '1'); } catch (e) {}
      };

      // Genuine exit signal: pointer leaves viewport top (desktop), min 20s dwell
      document.addEventListener('mouseout', (e) => {
        if (!e.relatedTarget && e.clientY <= 0 && dwell() >= 20000) open();
      });
      // Mobile fallback: deep scroll + real dwell, throttled via rAF flag
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (ticking || suppressed()) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          if (max > 0 && h.scrollTop / max > 0.6 && dwell() >= 30000) open();
        });
      }, { passive: true });

      // Any purchase-path engagement = no popup needed
      document.querySelectorAll('[data-track*="offer"], [data-track*="buy"]').forEach((el) => {
        el.addEventListener('click', markConverted);
      });
      document.getElementById('exit-close')?.addEventListener('click', close);
      document.getElementById('exit-dismiss')?.addEventListener('click', close);
      document.getElementById('exit-backdrop')?.addEventListener('click', close);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      document.getElementById('offer-form')?.addEventListener('submit', markConverted);
      document.getElementById('exit-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const v = document.getElementById('exit-email').value.trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)) {
          document.getElementById('exit-email')?.focus();
          return;
        }
        markConverted();
        window.location.href = `mailto:sales@desertrich.com?subject=${encodeURIComponent('First-refusal request — 480Local.com')}&body=${encodeURIComponent('Please notify me before accepting any other offer for 480Local.com.\n\nEmail: ' + v + '\n')}`;
        close();
      });
    })();
  </script>
</Layout>
